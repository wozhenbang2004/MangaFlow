<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Media CDN hosts are returned at playback time, so a build-time domain
         list cannot cover them. The opt-in media transport validates each URL,
         scopes headers and pins HTTP connections to checked public DNS results.
         Ordinary NetworkClient requests retain the former seven-host HTTP gate;
         script APIs additionally require their exact endpoint grants. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
