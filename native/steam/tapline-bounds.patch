@@ -0,0 +1,56 @@
+//! Immutable per-owner routes. These never alter process environment or OS VPN policy.
+use std::io;
+use std::time::Duration;
+use tokio::net::TcpStream;
+use tokio::time::timeout;
+use tokio_socks::tcp::Socks5Stream;
+
+#[derive(Clone, Default)]
+pub enum NetworkRoute {
+    #[default]
+    System,
+    Direct,
+    Http { host: String, port: u16 },
+    Socks5 { host: String, port: u16 },
+}
+
+fn valid_host(host: &str, port: u16) -> bool {
+    !host.is_empty() && host.len() <= 253 && port > 0 &&
+        !host.chars().any(|c| c.is_control() || c.is_whitespace() ||
+            matches!(c, '/' | '\\' | '@' | '?' | '#' | '[' | ']'))
+}
+
+impl NetworkRoute {
+    /// A new client/pool owns this snapshot for its whole job. There is no direct fallback.
+    pub async fn connect(&self, host: &str, port: u16) -> io::Result<TcpStream> {
+        if !valid_host(host, port) {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "invalid destination"));
+        }
+        timeout(Duration::from_secs(30), async {
+            let stream = match self {
+                Self::System | Self::Direct => TcpStream::connect((host, port)).await?,
+                Self::Http { host: proxy_host, port: proxy_port } => {
+                    if !valid_host(proxy_host, *proxy_port) {
+                        return Err(io::Error::new(io::ErrorKind::InvalidInput, "invalid proxy"));
+                    }
+                    let mut stream = TcpStream::connect((proxy_host.as_str(), *proxy_port)).await?;
+                    // CONNECT carries the target hostname to the proxy; it is not resolved locally.
+                    async_http_proxy::http_connect_tokio(&mut stream, host, port).await
+                        .map_err(|_| io::Error::new(io::ErrorKind::ConnectionRefused, "HTTP proxy connection failed"))?;
+                    stream
+                }
+                Self::Socks5 { host: proxy_host, port: proxy_port } => {
+                    if !valid_host(proxy_host, *proxy_port) {
+                        return Err(io::Error::new(io::ErrorKind::InvalidInput, "invalid proxy"));
+                    }
+                    // A domain tuple becomes SOCKS ATYP=DOMAIN, preserving proxy-side DNS.
+                    Socks5Stream::connect((proxy_host.as_str(), *proxy_port), (host, port)).await
+                        .map_err(|_| io::Error::new(io::ErrorKind::ConnectionRefused, "SOCKS proxy connection failed"))?
+                        .into_inner()
+                }
+            };
+            stream.set_nodelay(true)?;
+            Ok(stream)
+        }).await.map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "connection timed out"))?
+    }
+}
